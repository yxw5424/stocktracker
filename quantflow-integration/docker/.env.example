# 复制成 .env 再填。

# Claude key：留空也能跑（内置聊天回退 DeepSeek，AI 顾问节点走 mock 兜底）。
ANTHROPIC_API_KEY=

# 【仅带数据版 docker-compose.data.yml 需要】
# 指向你从 PandaAI 网盘包解压出来的 data/db 目录（MongoDB 数据目录）。
#   Windows 例：MONGO_DB_PATH=C:\Users\me\pandadb\data\db
#   Mac/Lin 例：MONGO_DB_PATH=/Users/me/pandadb/data/db
MONGO_DB_PATH=

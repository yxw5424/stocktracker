# 复制成 .env 再填。

# Claude key：留空也能跑（内置聊天回退 DeepSeek，AI 顾问节点走 mock 兜底）。
# 来源是 platform.claude.com（API 控制台，按量付费）——不是 claude.ai 订阅，两者账号/付费独立。
ANTHROPIC_API_KEY=

# DeepSeek key（可选，国内开通方便，platform.deepseek.com）：
# AI 顾问节点 provider 选 deepseek 时用它；没有 Claude key 时推荐配这个。
DEEPSEEK_API_KEY=

# 【数据导入器 loader 可选】灌自选股行情时的默认参数(也可命令行临时设)。
#   自选股清单默认读 watchlist.txt;WATCHLIST 可覆盖,如 WATCHLIST=600519,000001,300750
START_DATE=20240101
# END_DATE=            # 留空=今天
# LOAD_MINUTE=1        # 设 1 额外拉分时线(慢、量大)
# WATCHLIST=

# 【仅带数据版 docker-compose.data.yml 需要】
# 指向你从 PandaAI 网盘包解压出来的 data/db 目录（MongoDB 数据目录）。
#   Windows 例：MONGO_DB_PATH=C:\Users\me\pandadb\data\db
#   Mac/Lin 例：MONGO_DB_PATH=/Users/me/pandadb/data/db
MONGO_DB_PATH=
